alert tcp any any -> any any (msg:"NetSentinel - Possible TCP SYN Port Scan"; flags:S; flow:stateless; threshold:type threshold, track by_src, count 10, seconds 60; classtype:attempted-recon; sid:1000001; rev:2;)
alert udp any any -> any any (msg:"NetSentinel - Possible UDP Port Scan"; threshold:type threshold, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:1000002; rev:2;)
alert icmp any any -> any any (msg:"NetSentinel - Possible ICMP Echo Flood"; itype:8; threshold:type threshold, track by_src, count 50, seconds 10; classtype:attempted-dos; sid:1000003; rev:2;)
alert dns any any -> any any (msg:"NetSentinel - Suspiciously Long DNS Query"; dns.query; pcre:"/.{80,}/"; classtype:bad-unknown; sid:1000004; rev:2;)
alert http any any -> any any (msg:"NetSentinel - SQL Injection UNION SELECT"; flow:established,to_server; http.uri; pcre:"/union.{0,100}select/i"; classtype:web-application-attack; sid:1000005; rev:1;)
alert http any any -> any any (msg:"NetSentinel - SQL Injection OR 1=1"; flow:established,to_server; http.uri; pcre:"/or(%20|\+|\s)+1(%20|\+|\s)*=(%20|\+|\s)*1/i"; classtype:web-application-attack; sid:1000006; rev:1;)